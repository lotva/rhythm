---
interface Props {
	title: string
	tagline: string
}

const { title, tagline } = Astro.props
---

<hgroup class="hgroup">
	<h1 class="title">{title}</h1>
	<p class="tagline">{tagline}</p>
</hgroup>

<style>
	.title {
		font-size: inherit;
	}

	.tagline {
		max-inline-size: 90%;
		margin-block-start: gap();
	}
</style>
